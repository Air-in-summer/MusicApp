<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicApplication.PersonalPages.ArtistPage"
             xmlns:views="clr-namespace:MusicApplication.PersonalPages"
             Title="ArtistPage"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto, Auto, Auto,*, Auto">
        <VerticalStackLayout Grid.Row="0" Margin="0">
            <Grid ColumnDefinitions="Auto, *" >
                <ImageButton Grid.Column="0"
                             HeightRequest="30"
                             WidthRequest="30"
                             Source="back_icon.png" Margin="20, 20, 0, 10"
                             CornerRadius="50"
                             Clicked="OnBackButtonTapped"
                             VerticalOptions="Center"
                             HorizontalOptions="End" /> 
                <Label Text="Thông tin nghệ sĩ" Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Start" Margin="20, 15, 10, 10" FontSize="24" TextColor="Black"/>

            </Grid>

            <BoxView BackgroundColor="LightGray" HeightRequest="10" Margin="0, 0, 0, 15"/>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1">

            <!-- Sử dụng AbsoluteLayout để chồng ảnh lên -->
            <AbsoluteLayout HeightRequest="130">

                <!-- Vùng trên màu light blue -->
                <BoxView Color="LightBlue"
                         AbsoluteLayout.LayoutBounds="0,0,1,0.5"
                         AbsoluteLayout.LayoutFlags="All" />

                <!-- Vùng dưới màu trắng -->
                <BoxView Color="White"
                         AbsoluteLayout.LayoutBounds="0,1,1,0.5"
                         AbsoluteLayout.LayoutFlags="All" />    

                <!-- Ảnh đại diện -->
                <Frame  AbsoluteLayout.LayoutBounds="0.05,0.5,80,80"
                        AbsoluteLayout.LayoutFlags="PositionProportional"
                        CornerRadius="50"
                        IsClippedToBounds="True"
                        BorderColor="LightGray"
                        BackgroundColor="White"
                        Padding="0"
                        HasShadow="False">
                    <Image Source="user_icon.png" Aspect="AspectFill" />
                </Frame>
            </AbsoluteLayout>

            <!-- Tên người dùng -->
            <Label x:Name="LabelUserName"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Start"
                   VerticalOptions="Start"
                   Margin="25,-10,0,0" />

        </VerticalStackLayout>

        <Label x:Name="ListTrackLabel"  FontSize="18" HorizontalOptions="Start"  Grid.Row="2" FontAttributes="Bold" Margin="10,30,0,0"/>

        <ListView Grid.Row="3"
                  x:Name="TracksListView"
                  ItemsSource="{Binding Tracks}"
                  ItemSelected="TracksListView_ItemSelected"
                  RowHeight="100">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Grid  Padding="10" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Frame Grid.Column="0"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   BackgroundColor="LightGray"
                                   HasShadow="False"
                                   Padding="0"
                                   CornerRadius="8"
                                   VerticalOptions="Center">
                                <Image Source="track_cover.png"
                                       Aspect="AspectFill"
                                       WidthRequest="24"
                                       HeightRequest="24"/>
                            </Frame>
                            <!-- Thông tin bài hát -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold"/>
                                <Label Text="{Binding Artist}" FontSize="14" TextColor="Gray"/>
                                <Label Text="{Binding Duration}" FontSize="14" TextColor="Gray" />
                            </VerticalStackLayout>

                            <!-- Nút more (3 chấm) sát phải -->
                            <ImageButton Source="dots_icon.png"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         BackgroundColor="Transparent"
                                         Clicked="MoreButton_Clicked"
                                         CommandParameter="{Binding}"
                                         Grid.Column="2"
                                         HorizontalOptions="End"
                                         VerticalOptions="Center"/>
                        </Grid>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <views:MiniPlayerView VerticalOptions="End"
                      Grid.Row="4" />
    </Grid>
</ContentPage>