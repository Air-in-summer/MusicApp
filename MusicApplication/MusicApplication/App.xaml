<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MusicApplication"
             xmlns:viewmodels="clr-namespace:MusicApplication.ViewModels"
             x:Class="MusicApplication.App">
    <Application.Resources>
        <ResourceDictionary>
            <viewmodels:CategoryToVisibilityConverter x:Key="CategoryToVisibilityConverter"/>
            <viewmodels:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <viewmodels:HalfWidthConverter x:Key="HalfWidthConverter"/>
            <viewmodels:SelectedCategoryToColorConverter x:Key="SelectedCategoryToColorConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
