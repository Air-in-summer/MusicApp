<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicApplication.ManagePage.RegisterPage"
             Title="Trang đăng ký">
    <VerticalStackLayout Spacing="16" Padding="30">
        <Label Text="Tạo tài khoản mới" FontSize="22" HorizontalOptions="Center" />
        <Entry x:Name="UsernameEntry" Placeholder="Nhập tên người dùng" />
        <Entry x:Name="EmailEntry" Placeholder="Nhập email của bạn" Keyboard="Email" />
        <Entry x:Name="PasswordEntry" Placeholder="Nhập password" IsPassword="True" />
        <Entry x:Name="ConfirmPasswordEntry" Placeholder="Nhập lại password" IsPassword="True" />
        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />
        <Button Text="Đăng ký" Clicked="OnRegisterClicked" BackgroundColor="DarkGreen" TextColor="White"/>
        <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" />
    </VerticalStackLayout>
</ContentPage>