<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicApplication.ManagePage.LoginPage"
             Title="Trang đăng nhập">
    <VerticalStackLayout Spacing="16" Padding="30">
        <Label Text="Đăng nhập" FontSize="22" HorizontalOptions="Center" />
        <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
        <Entry x:Name="PasswordEntry" Placeholder="Mật khẩu" IsPassword="True" />
        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />
        <Button Text="Đăng nhập" Clicked="OnLoginClicked" TextColor="White" BackgroundColor="Blue" />
        <ActivityIndicator x:Name="BusyIndicator" IsVisible="False" IsRunning="False" />
    </VerticalStackLayout>
</ContentPage>