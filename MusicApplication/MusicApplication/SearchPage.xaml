<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MusicApplication.SearchPage"
             xmlns:views="clr-namespace:MusicApplication.PersonalPages"
             xmlns:local="clr-namespace:MusicApplication"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto">
        <VerticalStackLayout Grid.Row="0" Margin="0">
            <Label Text="Tìm kiếm" Margin="20, 15, 10, 10 " FontSize="24" TextColor="Black"/>
            <BoxView BackgroundColor="LightGray" HeightRequest="10" Margin="0, 0, 0, 10"/>
        </VerticalStackLayout>
        
        <!-- Thanh tìm kiếm -->
        <SearchBar Grid.Row="1"
                   x:Name="SearchBar"
                   Placeholder="Nhập từ khóa tìm kiếm..."
                   SearchButtonPressed="OnSearchBarPressed"
                   TextChanged="OnSearchBarTextChanged" />

        <!-- Tab chọn danh mục -->
        <CollectionView x:Name="SearchCategoryCollection" 
                Grid.Row="2"
                ItemsSource="{Binding Categories}"
                SelectionMode="Single"
                SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                SelectionChanged="OnCategoryChanged"
                ItemsLayout="HorizontalList">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid
                        WidthRequest="{Binding Source={x:Reference SearchCategoryCollection}, Path=Width, Converter={StaticResource HalfWidthConverter}}"
                        HeightRequest="50"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin ="7, 10, 7, 0 " 
                        
                        BackgroundColor="LightGray">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="CommonStates">
                                <VisualState Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="LightGray" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="LightBlue" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Label Text="{Binding Name}" 
                               FontAttributes="Bold"
                               FontSize="18"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="Black" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>


        <BoxView Grid.Row="3" BackgroundColor="Black" HeightRequest="1" />
        
        <!-- Danh sách kết quả bài hát-->
        <ScrollView Grid.Row="4"
            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type local:SearchPage}}, Path=BindingContext.SelectedCategory, Converter={StaticResource CategoryToVisibilityConverter}, ConverterParameter='Songs'}">

            <ListView x:Name="SearchResultsListView"
                      ItemsSource="{Binding SearchResults}"
                      ItemSelected="SearchResultsListView_ItemSelected"
                      RowHeight="100">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Frame Grid.Column="0"
                                       WidthRequest="36"
                                       HeightRequest="36"
                                       BackgroundColor="LightGray"
                                       HasShadow="False"
                                       Padding="0"
                                       CornerRadius="8"
                                       VerticalOptions="Center">
                                    <Image Source="track_cover.png"
                                           Aspect="AspectFill"
                                           WidthRequest="24"
                                           HeightRequest="24"/>
                                </Frame>
                                <!-- Bài hát -->
                                <StackLayout Grid.Column="1" VerticalOptions="Center" >
                                    <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold"/>
                                    <Label Text="{Binding Artist}" FontSize="14" TextColor="Gray"/>
                                    <Label Text="{Binding Duration}" FontSize="14" TextColor="Gray" />
                                </StackLayout>
                               
                                <ImageButton Source="dots_icon.png"
                                             WidthRequest="24"
                                             HeightRequest="24"
                                             Grid.Column="2"
                                             VerticalOptions="Center"
                                             HorizontalOptions="End"
                                             Clicked="MoreButton_Clicked"
                                             CommandParameter="{Binding}" />
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollView>

        <ScrollView Grid.Row="4" IsVisible="{Binding Source={RelativeSource AncestorType={x:Type local:SearchPage}}, Path=BindingContext.SelectedCategory, Converter={StaticResource CategoryToVisibilityConverter}, ConverterParameter='Artists'}"
>
            <ListView x:Name="SearchUserResultsListView"
                      ItemsSource="{Binding UserResults}"
                      RowHeight="100"
                      ItemSelected="SearchUserResultsListView_ItemSelected"    >
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Grid Padding="10" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Frame Grid.Column="0"
                                       WidthRequest="36"
                                       HeightRequest="36"
                                       BackgroundColor="LightGray"
                                       HasShadow="False"
                                       Padding="0"
                                       CornerRadius="8"
                                       VerticalOptions="Center">
                                    <Image Source="user_icon.png"
                                           Aspect="AspectFill"
                                           WidthRequest="24"
                                           HeightRequest="24"/>
                                </Frame>
                                <!-- Nghệ sĩ -->
                                <StackLayout Grid.Column="1" Padding="0, 25, 0, 0">
                                    <Label Text="{Binding Username}" VerticalOptions="Center" HorizontalOptions="Start" FontSize="18" FontAttributes="Bold"/>

                                </StackLayout>
                            </Grid>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </ScrollView>

        <views:MiniPlayerView VerticalOptions="End"
                      Grid.Row="5" />
    </Grid>

</ContentPage>
